    "https://schemas.dataspecer.com/documentation-generator-config/": {
      "partials": {
        "abstract": "<section id=\"abstract\">\n<p>\n  This document defines a vocabulary (classes and properties) used in <a href=\"https://w3id.org/dsv-dap#\">Data Specification Vocabulary Default Application Profile (DSV-DAP)</a> for machine processable representation of Data Specifications and Application Profiles. DSV and DSV-DAP are created using <a href=\"https://dataspecer.com\">Dataspecer</a>, a tool for management of data specifications, management of application profiles and semi-automatic generation of technical artifacts such as data schemas and transformations based on semantic vocabularies.\n</p>\n\n<p>\n  Preferred prefix: <code>dsv</code>, stands for <code>https://w3id.org/dsv#</code>.\n</p>\n\n<p>\n  This specification and the specification of <a href=\"https://w3id.org/dsv-dap#\">DSV-DAP</a> are both described using DSV-DAP.\n<p>\n</section>",
        "introduction": "",
        "respecConfig": "var respecConfig = {\n    specStatus: \"base\",\n    shortName: \"dsv\",               \n    showPreviousVersion: false,\n    thisVersion: \"https://mff-uk.github.io/data-specification-vocabulary/dsv/\",\n    latestVersion: \"https://mff-uk.github.io/data-specification-vocabulary/dsv/\",\n    editors: [{\n      name: \"Jakub Klímek\",\n      orcid: \"0000-0001-7234-3051\",\n      company:    \"Charles University\",\n      companyURL: \"https://www.mff.cuni.cz\"\n    }],\n    inlineCSS: \"true\",\n    github: \"https://github.com/mff-uk/data-specification-vocabulary/\",\n    otherLinks: [{\n        key: \"Links\",\n        data: [{\n            value: \"Dataspecer\",\n            href: \"https://dataspecer.com\"\n        },{\n            value: \"Data Specification Vocabulary Default Application Profile (DSV-DAP)\",\n            href: \"https://mff-uk.github.io/data-specification-vocabulary/dsv-dap/\"\n        },{\n            value: \"Sample specifications\",\n            href: \"https://mff-uk.github.io/specifications/\"\n        }]\n    }]\n  };"
      }
